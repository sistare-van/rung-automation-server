# Port the Express server listens on (Railway sets this automatically)
PORT=

# Display name of the client business (used in SMS alerts and email signatures)
CLIENT_NAME=

# First name of the business owner (used in email sign-off and prompt)
OWNER_NAME=

# Owner's cell phone number to receive SMS lead alerts (E.164 format, e.g. +15555550100)
OWNER_PHONE=

# Notion integration token (from https://www.notion.so/my-integrations)
NOTION_TOKEN=

# ID of the Notion database where new leads are saved
NOTION_DATABASE_ID=

# Twilio Account SID (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=

# Twilio Auth Token (from https://console.twilio.com)
TWILIO_AUTH_TOKEN=

# Twilio phone number to send SMS from (E.164 format, e.g. +15555550200)
TWILIO_FROM_NUMBER=

# Anthropic API key for Claude AI email generation (from https://console.anthropic.com)
CLAUDE_API_KEY=

# Gmail address used to send the automated reply to the lead
GMAIL_USER=

# Gmail App Password (not your regular password — generate at myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=

# Owner's email address (optional — currently unused, reserved for future owner notifications)
OWNER_EMAIL=
